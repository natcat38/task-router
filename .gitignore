# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
dist/

# Environment
.env

# Databases
*.db
*.sqlite
*.sqlite3
data/audit.sqlite

# S7 battery runtime artifacts (regenerated by battery.py / feedback.py each
# run, never committed -- see README Results section for the numbers)
data/battery_progress.json
data/battery*_progress.json
data/battery_results*
data/feedback.json

# Operator hand-labelling worksheet (working doc, never committed)
data/opus_labelling_worksheet.md

# auto_label.py runtime artifacts (regenerated each run, never committed --
# --merge is what turns data/auto_labels.json into tracked data/prompts.json
# changes, done separately by the operator)
data/auto_labels.json
data/auto_label.sqlite
data/auto_label_progress.json

# S8 demo fixture is committed on purpose — negate the DB ignore above for it
!data/fixtures/
!data/fixtures/**

# Run artifacts
runs/

# Trained classifier artifacts (regenerable via train.py, not committed)
models/

# Research notes — intentionally kept local, never committed
docs/research/

# Node / React (S6 UI)
node_modules/
coverage/
.vercel/

# Editor / OS
.DS_Store
Thumbs.db
.idea/
*.swp

# Claude Code local settings
.claude/settings.local.json
.claude/launch.json
